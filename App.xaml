<Application x:Class="DotARPG.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#D3DBCC" />
      <Setter Property="Background" Value="#B00E211F" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="#304C6558" />
      <Setter Property="Padding" Value="13,8" />
      <Setter Property="Margin" Value="5,0,0,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="#E0284137" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#E4C58C" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
  </Application.Resources>
</Application>
